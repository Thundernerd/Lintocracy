# Database connection (libSQL / SQLite).
# Local file (default): a SQLite file under .data/
DATABASE_URL=file:.data/rule-wars.db

# For a hosted libSQL/Turso database, use the remote URL + auth token instead:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-token

# Secret used to sign group admin cookies. Set a long random value in production.
ADMIN_SECRET=change-me-to-a-long-random-string
